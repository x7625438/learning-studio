# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# DeepSeek AI Configuration
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
TEXT_MODEL=deepseek-v4-flash
VISION_MODEL=deepseek-v4-flash

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:80,http://localhost:5173,http://your-domain.com

# Vector Search (optional, set to 1 to enable ChromaDB)
ENABLE_VECTOR_SEARCH=0

# Port Configuration (for docker-compose)
BACKEND_PORT=3000
FRONTEND_PORT=80
